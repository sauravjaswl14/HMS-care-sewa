generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECH
  BILLING
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  OPEN
  CLOSED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

enum LabStatus {
  ORDERED
  COLLECTED
  COMPLETED
  CANCELLED
}

enum LabFlag {
  NORMAL
  ABNORMAL
  CRITICAL
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  INSURANCE
  ONLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(RECEPTIONIST)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor     Doctor?
  auditLogs  AuditLog[]
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     Service[]
  doctors      Doctor[]
  appointments Appointment[]
  labTests     LabTest[]
  wards        Ward[]
}

/// Something a department offers and bills for: a consultation, an ECG, an X-ray.
model Service {
  id           String   @id @default(cuid())
  departmentId String
  code         String   @unique
  name         String
  description  String?
  durationMin  Int      @default(15)
  price        Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department    @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  invoiceLines InvoiceLine[]

  @@index([departmentId])
}

model Doctor {
  id              String   @id @default(cuid())
  userId          String?  @unique
  departmentId    String
  name            String
  specialization  String
  licenseNo       String   @unique
  email           String?
  phone           String?
  consultationFee Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  schedules    DoctorSchedule[]
  timeOff      DoctorTimeOff[]
  appointments Appointment[]
  encounters   Encounter[]
  admissions   Admission[]

  @@index([departmentId])
}

/// A recurring weekly working block. weekday: 0 = Sunday … 6 = Saturday. Times are "HH:mm" in the clinic time zone.
model DoctorSchedule {
  id          String @id @default(cuid())
  doctorId    String
  weekday     Int
  startTime   String
  endTime     String
  slotMinutes Int    @default(20)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday])
}

model DoctorTimeOff {
  id       String   @id @default(cuid())
  doctorId String
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
}

model Patient {
  id                String    @id @default(cuid())
  mrn               String    @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  phone             String
  email             String?
  address           String?
  bloodGroup        String?
  allergies         String?
  emergencyName     String?
  emergencyPhone    String?
  insuranceProvider String?
  insuranceNo       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appointments  Appointment[]
  encounters    Encounter[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  admissions    Admission[]
  invoices      Invoice[]

  @@index([lastName, firstName])
  @@index([phone])
}

model Appointment {
  id           String            @id @default(cuid())
  number       String            @unique
  patientId    String
  doctorId     String
  departmentId String
  serviceId    String?
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(SCHEDULED)
  reason       String?
  notes        String?
  /// "<doctorId>|<startsAt ISO>" while the booking holds its slot; null once cancelled or missed. The unique index makes double booking impossible even under concurrent requests.
  slotKey      String?           @unique
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  patient    Patient     @relation(fields: [patientId], references: [id])
  doctor     Doctor      @relation(fields: [doctorId], references: [id])
  department Department  @relation(fields: [departmentId], references: [id])
  service    Service?    @relation(fields: [serviceId], references: [id])
  encounter  Encounter?
  invoices   Invoice[]

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
}

/// The clinical record of one visit.
model Encounter {
  id            String          @id @default(cuid())
  appointmentId String?         @unique
  patientId     String
  doctorId      String
  status        EncounterStatus @default(OPEN)
  complaint     String?
  bloodPressure String?
  pulse         Int?
  temperatureC  Decimal?        @db.Decimal(4, 1)
  spo2          Int?
  weightKg      Decimal?        @db.Decimal(5, 1)
  heightCm      Decimal?        @db.Decimal(5, 1)
  diagnosis     String?
  notes         String?
  followUpOn    DateTime?
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  doctor        Doctor          @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]
  labOrders     LabOrder[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

model Medicine {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  genericName  String?
  form         String
  strength     String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  stock        Int      @default(0)
  reorderLevel Int      @default(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        PrescriptionItem[]
  invoiceLines InvoiceLine[]
}

model Prescription {
  id          String             @id @default(cuid())
  number      String             @unique
  encounterId String
  patientId   String
  status      PrescriptionStatus @default(PENDING)
  notes       String?
  dispensedAt DateTime?
  createdAt   DateTime           @default(now())

  encounter Encounter          @relation(fields: [encounterId], references: [id])
  patient   Patient            @relation(fields: [patientId], references: [id])
  items     PrescriptionItem[]

  @@index([status, createdAt])
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      String
  durationDays   Int
  quantity       Int
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])
}

model LabTest {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  departmentId String?
  price        Decimal  @db.Decimal(12, 2)
  sampleType   String?
  normalRange  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id])
  orders     LabOrder[]
}

model LabOrder {
  id          String    @id @default(cuid())
  number      String    @unique
  patientId   String
  encounterId String?
  testId      String
  orderedById String?
  status      LabStatus @default(ORDERED)
  urgent      Boolean   @default(false)
  result      String?
  flag        LabFlag?
  collectedAt DateTime?
  resultedAt  DateTime?
  createdAt   DateTime  @default(now())

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])
  test      LabTest    @relation(fields: [testId], references: [id])

  @@index([status, createdAt])
  @@index([patientId])
}

model Ward {
  id           String   @id @default(cuid())
  name         String   @unique
  departmentId String?
  kind         String   @default("General")
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id])
  beds       Bed[]
}

model Bed {
  id           String    @id @default(cuid())
  wardId       String
  number       String
  status       BedStatus @default(AVAILABLE)
  dailyRate    Decimal   @db.Decimal(12, 2)

  ward       Ward        @relation(fields: [wardId], references: [id])
  admissions Admission[]

  @@unique([wardId, number])
}

model Admission {
  id           String          @id @default(cuid())
  number       String          @unique
  patientId    String
  bedId        String
  doctorId     String
  reason       String
  status       AdmissionStatus @default(ADMITTED)
  admittedAt   DateTime        @default(now())
  dischargedAt DateTime?
  summary      String?

  patient  Patient   @relation(fields: [patientId], references: [id])
  bed      Bed       @relation(fields: [bedId], references: [id])
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
  invoices Invoice[]

  @@index([status])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  patientId     String
  appointmentId String?
  admissionId   String?
  status        InvoiceStatus @default(ISSUED)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paid          Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  issuedAt      DateTime      @default(now())

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  admission   Admission?   @relation(fields: [admissionId], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  serviceId   String?
  medicineId  String?

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id])
  medicine Medicine? @relation(fields: [medicineId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  paidAt      DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}
